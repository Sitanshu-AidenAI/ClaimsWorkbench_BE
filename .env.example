# Claims Workbench — backend environment
#
# Copy to `.env` for local development. Every setting is optional: the defaults
# in app/core/config.py match the docker-compose stack.
# Never commit a populated `.env`.

# --- Application -----------------------------------------------------------
CWB_PROJECT_NAME="Claims Workbench API"
CWB_ENVIRONMENT=local            # local | test | staging | production
CWB_DEBUG=false
CWB_HOST=0.0.0.0
CWB_PORT=8000
CWB_RELOAD=true
CWB_API_V1_PREFIX=/api/v1

# Comma-separated, or a JSON array
CWB_CORS_ORIGINS=http://localhost:5173

# --- Postgres --------------------------------------------------------------
# Port matches the docker-compose host mapping (CWB_PG_PORT), which is off the
# default so this stack coexists with other projects on the same machine.
CWB_POSTGRES_HOST=localhost
CWB_POSTGRES_PORT=5442
CWB_POSTGRES_USER=claims
CWB_POSTGRES_PASSWORD=claims
CWB_POSTGRES_DB=claims_workbench
CWB_POSTGRES_POOL_MIN_SIZE=5
CWB_POSTGRES_POOL_MAX_SIZE=20
CWB_POSTGRES_SQLALCHEMY_POOL_SIZE=10
CWB_POSTGRES_SQLALCHEMY_ECHO=false

# --- Redis -----------------------------------------------------------------
CWB_REDIS_HOST=localhost
CWB_REDIS_PORT=6389
CWB_REDIS_DB=0
# CWB_REDIS_PASSWORD=
CWB_REDIS_CELERY_BROKER_DB=1
CWB_REDIS_CELERY_RESULT_DB=2

# --- Keycloak --------------------------------------------------------------
CWB_KEYCLOAK_SERVER_URL=http://localhost:8090
CWB_KEYCLOAK_REALM=claims-workbench
CWB_KEYCLOAK_CLIENT_ID=claims-workbench-api
# CWB_KEYCLOAK_CLIENT_SECRET=
CWB_KEYCLOAK_AUDIENCE=account
CWB_KEYCLOAK_VERIFY_AUDIENCE=true
CWB_KEYCLOAK_JWKS_CACHE_TTL_SECONDS=3600

# --- Object storage (MinIO locally) ---------------------------------------
CWB_S3_ENDPOINT_URL=http://localhost:9020
CWB_S3_REGION=us-east-1
CWB_S3_ACCESS_KEY_ID=minioadmin
CWB_S3_SECRET_ACCESS_KEY=minioadmin
CWB_S3_BUCKET=claims-documents
CWB_S3_PRESIGN_EXPIRY_SECONDS=900
CWB_S3_USE_PATH_STYLE=true

# --- Celery ----------------------------------------------------------------
CWB_CELERY_TASK_DEFAULT_QUEUE=default
CWB_CELERY_TASK_TIME_LIMIT=600
CWB_CELERY_TASK_SOFT_TIME_LIMIT=540
CWB_CELERY_TASK_ALWAYS_EAGER=false

# --- FNOL intake -----------------------------------------------------------
# Underwriting thresholds the pipeline reads. Amounts are in minor units.
# CWB_FNOL_SEVERITY_MEDIUM_THRESHOLD_MINOR=2500000
# CWB_FNOL_SEVERITY_HIGH_THRESHOLD_MINOR=25000000
# CWB_FNOL_SEVERITY_CRITICAL_THRESHOLD_MINOR=100000000
# CWB_FNOL_MAJOR_LOSS_THRESHOLD_MINOR=50000000
# CWB_FNOL_DUPLICATE_SIMILARITY_THRESHOLD=0.62
# CWB_FNOL_LOW_CONFIDENCE_THRESHOLD=0.60
# CWB_FNOL_CAT_MATCH_THRESHOLD=0.55
# CWB_FNOL_MAX_DOCUMENT_BYTES=26214400

# Where attachment bytes live: `s3` (the deployed answer) or `filesystem`, for a
# machine running without object storage. Never detected — always configured.
CWB_FNOL_DOCUMENT_STORE=s3
# CWB_FNOL_DOCUMENT_STORE_PATH=./var/documents

# --- Microsoft Graph / Outlook mailbox intake ------------------------------
# FNOL notifications collected from a shared Outlook mailbox. Application
# permissions (client credentials): the service reads the mailbox as itself, so
# no user signs in and Keycloak is not involved in this flow at all.
#
# Required application permission: Mail.ReadWrite (Mail.Read is enough only if
# CWB_GRAPH_MARK_AS_READ=false). Admin consent is required, and the app should
# be scoped to this one mailbox with an application access policy. See
# docs/mail-intake.md.
#
# The bare `GRAPH_TENANT_ID` / `OUTLOOK_SHARED_MAILBOX` names are also accepted,
# so credentials can be pasted in the form Azure hands them over.
# CWB_GRAPH_TENANT_ID=
# CWB_GRAPH_CLIENT_ID=
# CWB_GRAPH_CLIENT_SECRET=
# CWB_GRAPH_SHARED_MAILBOX=claims@carrier.example

# Folder to read, and whether to read only what nobody has opened.
# CWB_GRAPH_MAIL_FOLDER=inbox
# CWB_GRAPH_UNREAD_ONLY=true
# CWB_GRAPH_BATCH_SIZE=25
# Messages are retried this many times before being left for a human.
# CWB_GRAPH_MAX_ATTEMPTS=3

# Scheduling. The beat entry is registered only when this is true *and* the
# four credentials above are set.
# CWB_GRAPH_POLL_ENABLED=false
# CWB_GRAPH_POLL_INTERVAL_SECONDS=300

# What intake does to the mailbox. Marking read is how the folder drains and is
# the only mutation on by default; moving is opt-in, because it changes what the
# claims team sees in Outlook. Nothing is ever deleted.
# CWB_GRAPH_MARK_AS_READ=true
# CWB_GRAPH_MOVE_TO_FOLDER=

# Whether the mailbox is a broker mailbox (`broker_email` channel) or an insured
# one, and whether inline images are stored as documents.
# CWB_GRAPH_FROM_BROKER=true
# CWB_GRAPH_INCLUDE_INLINE_ATTACHMENTS=false

# --- Language model --------------------------------------------------------
# Leave the key unset to run the deterministic extractor in `app.domain.heuristics`.
# That path is fully supported: the module works end to end without a provider.
# CWB_AI_API_KEY=sk-...
# CWB_AI_BASE_URL=https://api.openai.com/v1
# CWB_AI_MODEL=gpt-5.6-luna
# Omit CWB_AI_TEMPERATURE on a GPT-5-family model: it accepts only its default.
# CWB_AI_TEMPERATURE=0
# One of none/low/medium/high/xhigh. Omitted takes the provider default.
# CWB_AI_REASONING_EFFORT=low
# CWB_AI_TIMEOUT_SECONDS=60
# CWB_AI_MAX_INPUT_CHARACTERS=60000
# CWB_AI_ENABLED=true

# --- Document intelligence -------------------------------------------------
# Reading claim documents into searchable, citable passages. See
# docs/document-intelligence.md. Nothing here is required: with none of it set,
# documents are still read and still cut into passages, retrieval falls back to
# Postgres full text, and a scan is reported as needing OCR rather than read.
CWB_DOCINT_ENABLED=true
#
# Vector search. Unset => keyword-only retrieval, which is a real fallback rather
# than a degraded one. The compose stack runs Qdrant on 6343.
# CWB_DOCINT_QDRANT_URL=http://localhost:6343
# CWB_DOCINT_QDRANT_COLLECTION=fnol_document_chunks
#
# Embeddings. Falls back to CWB_AI_API_KEY / CWB_AI_BASE_URL, so one key
# configures both — set these only to route them separately.
# CWB_DOCINT_EMBEDDING_API_KEY=sk-...
# CWB_DOCINT_EMBEDDING_MODEL=text-embedding-3-small
# CWB_DOCINT_EMBEDDING_DIMENSION=1536
#
# OCR, over HTTP, and detected automatically: a PDF is sent only when its text
# layer looks like a scan. Unset => a scan stays `unsupported` with a sentence
# saying so, which is what it does today.
# CWB_DOCINT_OCR_URL=http://localhost:8100
#
# Retrieval. Below RETRIEVAL_MIN_CHUNKS passages the whole corpus is sent instead:
# selecting six passages out of eight is overhead with a downside and no upside.
# CWB_DOCINT_RETRIEVAL_MIN_CHUNKS=12
# CWB_DOCINT_RETRIEVAL_TOP_K=6
# CWB_DOCINT_RETRIEVAL_MIN_SCORE=0.25
#
# The queue that consumes what mailbox intake leaves behind. Registered on beat
# only when enabled; without it a collected notice waits for someone to press
# a button.
CWB_DOCINT_QUEUE_POLL_ENABLED=true
# CWB_DOCINT_QUEUE_POLL_INTERVAL_SECONDS=60
# CWB_DOCINT_INDEX_MAX_ATTEMPTS=3

# --- Extraction datasets ---------------------------------------------------
# What the system reads out of a notice is configuration: a dataset of fields,
# each with a description that is used verbatim as its retrieval query. Edited
# through /api/v1/extraction/schemas; see docs/extraction-datasets.md.
#
# Off runs the fixed FNOL schema compiled into app/domain/extraction.py, exactly
# as the module behaved before datasets existed.
CWB_EXTRACT_SCHEMA_DRIVEN=true
# Create the bundled datasets on boot if missing. Additive: it never overwrites
# a field description an administrator has rewritten.
CWB_EXTRACT_SEED_ON_STARTUP=true
# Fields per model call. Retrieval is per field either way; batching is what
# stops a 30-field dataset costing 30 calls. Raise this first for a larger one.
# CWB_EXTRACT_FIELDS_PER_CALL=10
# CWB_EXTRACT_PASSAGES_PER_FIELD=4
# CWB_EXTRACT_MAX_PASSAGES_PER_CALL=30
# Passages of the notification body included in every call, whatever retrieval
# thought of them. The body is the notice itself.
# CWB_EXTRACT_BODY_CHUNKS_ALWAYS_INCLUDED=8
# CWB_EXTRACT_CALL_CONCURRENCY=3
# CWB_EXTRACT_REVIEW_THRESHOLD=0.6
# The rest of the weight goes to how well retrieval scored the passage the value
# was read from — a confident model reading an irrelevant passage is the failure
# this guards against.
# CWB_EXTRACT_LLM_CONFIDENCE_WEIGHT=0.7
# CWB_EXTRACT_CACHE_HIGHLIGHT_RECTS=true

# --- Development authentication -------------------------------------------
# Accept locally-minted `dev.<base64url(json)>` tokens instead of Keycloak's.
# Refused outright in staging and production, whatever this says.
CWB_DEV_AUTH=false
# CWB_DEV_AUTH_DEFAULT_ROLES=fnol-officer,claims-handler,claims-manager

# --- Observability ---------------------------------------------------------
CWB_OBS_LOG_LEVEL=INFO
# Unset => JSON in staging/production, console locally
# CWB_OBS_LOG_JSON=false
CWB_OBS_METRICS_ENABLED=true
CWB_OBS_METRICS_PATH=/metrics
CWB_OBS_REQUEST_ID_HEADER=X-Request-ID

# --- Gunicorn (production) -------------------------------------------------
# CWB_WEB_CONCURRENCY=4
# CWB_WORKER_TIMEOUT=60

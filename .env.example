# Claims Workbench — backend environment
#
# Copy to `.env` for local development. Every setting is optional: the defaults
# in app/core/config.py match the docker-compose stack.
# Never commit a populated `.env`.

# --- Application -----------------------------------------------------------
CWB_PROJECT_NAME="Claims Workbench API"
CWB_ENVIRONMENT=local            # local | test | staging | production
CWB_DEBUG=false
CWB_HOST=0.0.0.0
CWB_PORT=8000
CWB_RELOAD=true
CWB_API_V1_PREFIX=/api/v1

# Comma-separated, or a JSON array
CWB_CORS_ORIGINS=http://localhost:5173

# --- Postgres --------------------------------------------------------------
# Port matches the docker-compose host mapping (CWB_PG_PORT), which is off the
# default so this stack coexists with other projects on the same machine.
CWB_POSTGRES_HOST=localhost
CWB_POSTGRES_PORT=5442
CWB_POSTGRES_USER=claims
CWB_POSTGRES_PASSWORD=claims
CWB_POSTGRES_DB=claims_workbench
CWB_POSTGRES_POOL_MIN_SIZE=5
CWB_POSTGRES_POOL_MAX_SIZE=20
CWB_POSTGRES_SQLALCHEMY_POOL_SIZE=10
CWB_POSTGRES_SQLALCHEMY_ECHO=false

# --- Redis -----------------------------------------------------------------
CWB_REDIS_HOST=localhost
CWB_REDIS_PORT=6389
CWB_REDIS_DB=0
# CWB_REDIS_PASSWORD=
CWB_REDIS_CELERY_BROKER_DB=1
CWB_REDIS_CELERY_RESULT_DB=2

# --- Keycloak --------------------------------------------------------------
CWB_KEYCLOAK_SERVER_URL=http://localhost:8090
CWB_KEYCLOAK_REALM=claims-workbench
CWB_KEYCLOAK_CLIENT_ID=claims-workbench-api
# CWB_KEYCLOAK_CLIENT_SECRET=
CWB_KEYCLOAK_AUDIENCE=account
CWB_KEYCLOAK_VERIFY_AUDIENCE=true
CWB_KEYCLOAK_JWKS_CACHE_TTL_SECONDS=3600

# --- Object storage (MinIO locally) ---------------------------------------
CWB_S3_ENDPOINT_URL=http://localhost:9020
CWB_S3_REGION=us-east-1
CWB_S3_ACCESS_KEY_ID=minioadmin
CWB_S3_SECRET_ACCESS_KEY=minioadmin
CWB_S3_BUCKET=claims-documents
CWB_S3_PRESIGN_EXPIRY_SECONDS=900
CWB_S3_USE_PATH_STYLE=true

# --- Celery ----------------------------------------------------------------
CWB_CELERY_TASK_DEFAULT_QUEUE=default
CWB_CELERY_TASK_TIME_LIMIT=600
CWB_CELERY_TASK_SOFT_TIME_LIMIT=540
CWB_CELERY_TASK_ALWAYS_EAGER=false

# --- FNOL intake -----------------------------------------------------------
# Underwriting thresholds the pipeline reads. Amounts are in minor units.
# CWB_FNOL_SEVERITY_MEDIUM_THRESHOLD_MINOR=2500000
# CWB_FNOL_SEVERITY_HIGH_THRESHOLD_MINOR=25000000
# CWB_FNOL_SEVERITY_CRITICAL_THRESHOLD_MINOR=100000000
# CWB_FNOL_MAJOR_LOSS_THRESHOLD_MINOR=50000000
# CWB_FNOL_DUPLICATE_SIMILARITY_THRESHOLD=0.62
# CWB_FNOL_LOW_CONFIDENCE_THRESHOLD=0.60
# CWB_FNOL_CAT_MATCH_THRESHOLD=0.55
# CWB_FNOL_MAX_DOCUMENT_BYTES=26214400

# Where attachment bytes live: `s3` (the deployed answer) or `filesystem`, for a
# machine running without object storage. Never detected — always configured.
CWB_FNOL_DOCUMENT_STORE=s3
# CWB_FNOL_DOCUMENT_STORE_PATH=./var/documents

# --- Language model --------------------------------------------------------
# Leave the key unset to run the deterministic extractor in `app.domain.heuristics`.
# That path is fully supported: the module works end to end without a provider.
# CWB_AI_API_KEY=sk-...
# CWB_AI_BASE_URL=https://api.openai.com/v1
# CWB_AI_MODEL=gpt-4o-mini
# CWB_AI_TIMEOUT_SECONDS=60
# CWB_AI_MAX_INPUT_CHARACTERS=60000
# CWB_AI_ENABLED=true

# --- Development authentication -------------------------------------------
# Accept locally-minted `dev.<base64url(json)>` tokens instead of Keycloak's.
# Refused outright in staging and production, whatever this says.
CWB_DEV_AUTH=false
# CWB_DEV_AUTH_DEFAULT_ROLES=fnol-officer,claims-handler,claims-manager

# --- Observability ---------------------------------------------------------
CWB_OBS_LOG_LEVEL=INFO
# Unset => JSON in staging/production, console locally
# CWB_OBS_LOG_JSON=false
CWB_OBS_METRICS_ENABLED=true
CWB_OBS_METRICS_PATH=/metrics
CWB_OBS_REQUEST_ID_HEADER=X-Request-ID

# --- Gunicorn (production) -------------------------------------------------
# CWB_WEB_CONCURRENCY=4
# CWB_WORKER_TIMEOUT=60
